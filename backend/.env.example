# Django Application Secrets
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# TomTom Routing & Geocoding API
# Obtain from https://developer.tomtom.com
TOMTOM_API_KEY=your_tomtom_api_key_here

# Cache configuration (Redis on Upstash or Render; leave empty for LocMemCache in dev)
REDIS_URL=

# Demo mode (enables synthetic fallback routes when TomTom key is not configured)
DEMO_MODE=false

