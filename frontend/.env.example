# Backend API Base URL (leave blank for local dev proxy, set to Render URL in production)
VITE_API_BASE_URL=https://truck-weather-routing-api.onrender.com

# Map Style URL (OpenFreeMap requires NO api key and has no watermark)
# Alternative: https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_MAPTILER_KEY
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

